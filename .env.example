# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role (for webhooks and admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (required for email briefs)
RESEND_API_KEY=

# Stripe (required for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Price IDs (configure in Stripe Dashboard)
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=

# Default recipient for automated briefs (optional)
BRIEFS_DEFAULT_EMAIL=